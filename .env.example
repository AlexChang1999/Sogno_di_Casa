# ================================================================
# .env.example — 環境變數範本
# 使用方式：複製此檔案為 .env，填入真實值，.env 已在 .gitignore 中
# ================================================================

# ── 資料庫 ──────────────────────────────────────────────────────
DB_URL=jdbc:postgresql://localhost:5432/sognodicasa
DB_USERNAME=postgres
DB_PASSWORD=你的資料庫密碼

# ── JWT 密鑰（至少 32 字元，請用隨機字串）──────────────────────
# 產生方式（PowerShell）：
#   -join ((1..48) | ForEach-Object { [char](Get-Random -Min 33 -Max 127) })
JWT_SECRET=請替換成至少32字元的隨機字串

# ── Gmail SMTP ──────────────────────────────────────────────────
# Gmail 應用程式密碼：帳號 → 安全性 → 兩步驟驗證 → 應用程式密碼
GMAIL_USERNAME=你的gmail帳號@gmail.com
GMAIL_APP_PASSWORD=你的16碼應用程式密碼

# ── 管理員設定密鑰（用於 POST /api/auth/setup-admin）─────────────
# 請使用複雜隨機字串，不要用簡單英文單字
ADMIN_SETUP_SECRET=請替換成複雜的隨機字串

# ── 網站根網址（圖片 URL 用）────────────────────────────────────
# 本機開發留空或填 http://localhost:8080
# 正式環境填你的網域（不要有結尾斜線）
APP_BASE_URL=https://你的網域.com

# ── CORS（正式環境改成你的網域）─────────────────────────────────
# 開發環境：http://localhost:3333
# 正式環境：https://yourdomain.com
CORS_ALLOWED_ORIGINS=http://localhost:3333
